#!/usr/bin/env ruby
require "rbconfig"

Dir.chdir(File.expand_path("..", __dir__))
ENV["RAILS_ENV"] = "test"

def run_check(failures, *command)
  puts "\n> #{command.join(' ')}"
  success = system(*command)
  failures << command.join(" ") unless success
  success
end

failures = []
run_check(failures, RbConfig.ruby, "bin/check-syntax")
run_check(failures, "npm", "run", "format:check")
run_check(failures, "npm", "test")
run_check(failures, "npm", "run", "build")
run_check(failures, "bundle", "exec", "brakeman", "--no-pager", "--quiet")
# Unlike db:prepare, these tasks do not seed a newly created database.
if run_check(failures, "bin/rails", "db:create", "db:migrate")
  run_check(failures, "bin/rails", "zeitwerk:check")
  run_check(failures, "bin/rails", "test")
end
abort "\nFailed checks:\n#{failures.join("\n")}" unless failures.empty?
puts "\nAll checks passed."
